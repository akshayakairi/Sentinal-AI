APP_NAME=SentinelAI API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sentinelai

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

RAG_TOP_K=3
RAG_RETRIEVER=memory
CHROMA_PERSIST_DIRECTORY=.sentinelai/chroma
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

NVD_CVE_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
THREAT_INTELLIGENCE_TIMEOUT_SECONDS=10
CORS_ALLOW_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
